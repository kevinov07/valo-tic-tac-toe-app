# Copia este archivo como .env y rellena los valores según tu entorno.

# URL del backend (dev local o pro).
VITE_API_URL=http://localhost:8080

# ===== PUBLICIDAD (AdSense) =====
# VITE_AD_ENABLED=true  -> activa ads (solo en prod, nunca en dev)
# VITE_AD_ENABLED=false -> sin ads
VITE_AD_ENABLED=false

# ID del publisher de AdSense: "ca-pub-XXXXXXXXXXXXXXXX"
VITE_AD_CLIENT=

# IDs de cada slot "auto" de AdSense (formato "nnnnnnnnnn"):
VITE_AD_SLOT_HOME=
VITE_AD_SLOT_LOBBY=
VITE_AD_SLOT_WAITING=
VITE_AD_SLOT_RESULT=

# ===== MEDIA =====
# VITE_SHOW_MEDIA=true  -> muestra avatares de jugadores y logos de equipos (default)
# VITE_SHOW_MEDIA=false -> oculta toda imagen hotlinkeada (si AdSense/vlr se quejan)
VITE_SHOW_MEDIA=true